PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection
# Replace with your local URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/lokart

# JWT Configuration
JWT_SECRET=lokart_super_secret_jwt_key_2026_terai_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@lokart.com
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_NAME=LokArt Administrator
ADMIN_PHONE=9800000000

# Cloudinary (for avatar / image uploads)
# Get these from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
